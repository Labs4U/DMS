{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "electrifyMCPserver",
  "version": 1,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "electrifyMCPserver_Agent1",
      "build": "CodeZip",
      "entrypoint": "server.py",
      "codeLocation": "Labs/mcp_electrify/electrifyMCPserver/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        }
      ],
      "iamPolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "QueryConsumptionRecordGSI",
            "Effect": "Allow",
            "Action": [
              "dynamodb:Query",
              "dynamodb:GetItem",
              "dynamodb:PutItem",
              "dynamodb:BatchGetItem"
            ],
            "Resource": [
              "arn:aws:dynamodb:us-east-1:*:table/ConsumptionRecord-*",
              "arn:aws:dynamodb:us-east-1:*:table/ConsumptionRecord-*/index/*"
            ]
          }
        ]
      }
    }
  ]
}